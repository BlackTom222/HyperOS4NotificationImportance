<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/page_background" android:fitsSystemWindows="true"
    android:fillViewport="true" android:clipToPadding="false"
    android:overScrollMode="never" android:scrollbars="none" android:requiresFadingEdge="none"
    android:paddingStart="@dimen/page_padding" android:paddingEnd="@dimen/page_padding"
    android:paddingTop="24dp" android:paddingBottom="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityHeading="true" android:fontFamily="sans-serif-medium"
            android:text="@string/dashboard_title" android:textColor="@color/text_primary" android:textSize="28sp" />
        <TextView style="@style/HomeSummary" android:layout_marginTop="6dp" android:text="@string/page_subtitle" />

        <LinearLayout android:id="@+id/activation_card" style="@style/HomeCard" android:layout_marginTop="24dp">
            <TextView android:id="@+id/activation_status" style="@style/HomeTitle"
                android:accessibilityHeading="true" android:text="@string/activation_checking" />
            <TextView android:id="@+id/activation_card_summary" style="@style/HomeSummary"
                android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite"
                android:text="@string/activation_waiting_details" />
        </LinearLayout>

        <TextView style="@style/HomeSection" android:text="@string/section_scope" />
        <LinearLayout style="@style/HomeCard">
            <LinearLayout style="@style/StatusRow">
                <TextView style="@style/StatusRowLabel" android:text="@string/settings_scope_name" />
                <TextView android:id="@+id/settings_scope_status" style="@style/StatusRowValue" android:text="@string/scope_unknown" />
            </LinearLayout>
            <View style="@style/HomeDivider" />
            <LinearLayout style="@style/StatusRow">
                <TextView style="@style/StatusRowLabel" android:text="@string/systemui_scope_name" />
                <TextView android:id="@+id/systemui_scope_status" style="@style/StatusRowValue" android:text="@string/scope_unknown" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/HomeSection" android:text="@string/section_rules" />
        <LinearLayout style="@style/HomeCard">
            <LinearLayout style="@style/StatusRow">
                <TextView style="@style/StatusRowLabel" android:text="@string/rule_visible_levels" />
                <TextView style="@style/StatusRowValue" android:text="@string/rule_show" />
            </LinearLayout>
            <View style="@style/HomeDivider" />
            <LinearLayout style="@style/StatusRow">
                <TextView style="@style/StatusRowLabel" android:text="@string/rule_low_label" />
                <TextView style="@style/StatusRowValue" android:text="@string/rule_hide" />
            </LinearLayout>
            <TextView style="@style/HomeSummary" android:layout_marginTop="16dp" android:text="@string/rule_summary" />
        </LinearLayout>

        <TextView style="@style/HomeSection" android:text="@string/section_help" />
        <TextView style="@style/HomeSummary" android:text="@string/settings_path" />
        <Button android:id="@+id/details_toggle" style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:minHeight="48dp"
            android:text="@string/details_expand" android:textAllCaps="false"
            android:textColor="@color/text_secondary" android:textSize="14sp" />

        <LinearLayout android:id="@+id/details_panel" style="@style/HomeCard" android:visibility="gone">
            <TextView style="@style/HomeDetailLabel" android:text="@string/info_app_version" />
            <TextView android:id="@+id/app_version" style="@style/HomeSummary" android:layout_marginTop="4dp" />
            <TextView style="@style/HomeDetailLabel" android:layout_marginTop="20dp" android:text="@string/info_android_version" />
            <TextView android:id="@+id/android_version" style="@style/HomeSummary" android:layout_marginTop="4dp" />
            <TextView style="@style/HomeDetailLabel" android:layout_marginTop="20dp" android:text="@string/info_lsposed_version" />
            <TextView android:id="@+id/framework_details" style="@style/HomeSummary"
                android:layout_marginTop="4dp" android:text="@string/framework_disconnected" />
            <View style="@style/HomeDivider" android:layout_marginVertical="20dp" />
            <TextView style="@style/HomeDetailLabel" android:text="@string/section_restart" />
            <TextView android:id="@+id/root_status" style="@style/HomeSummary" android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite" android:text="@string/root_not_requested" />
            <Button android:id="@+id/restart_button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:minHeight="48dp"
                android:text="@string/restart_scope_with_root" android:textAllCaps="false" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
